{
  "manifest_version": 3,
  "name": "Nodis",
  "version": "1.1",
  "description": "Blocks algorithmic feeds on YouTube and X.com",
  "icons": {
    "128": "icons/icon.png"
  },
  "permissions": [],
  "host_permissions": ["*://*.youtube.com/*", "*://*.x.com/*", "*://*.twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["youtube/styles.css"],
      "js": ["youtube/content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "css": ["x/styles.css"],
      "js": ["config.js", "x/content.js"],
      "run_at": "document_end"
    }
  ]
}
